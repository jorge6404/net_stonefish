				<compound_transform rpy="1.6 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</internal_part>
			


		</base_link>

		<!--   PINZA DE DOS DEDOS   -->
		<!-- Geometría, joints y posición inicial de Cirtesu_blackbox_recovery_stonefish (ROS 1),
		     scenarios/robots/bluerov2_heavy.scn. Cambios: masas de ~100 g por dedo, inercia fijada a 1e-3 kg·m²
		     (con la de las mallas los servos divergen a 100 Hz), par de servo 10 N·m en vez de 10000 y material
		     Neutral (Polyamid no está en <materials>). Enlaces gripper/finger1 y gripper/finger2, como el ejemplo de
		     grippers en config/net.yaml. Mallas en stonefish_net/data/gripper. -->
		<link name="gripper/base" type="model" physics="submerged" buoyant="false">
			<physical>
				<mesh filename="$(find stonefish_net)/data/gripper/gripper_1.obj" scale="1.0"/>
				<origin rpy="0.0 0.0 0.0" xyz="0.0 0.1 0.0"/>
			</physical>
			<material name="Neutral"/>
			<mass value="0.2"/>
			<inertia xyz="0.001 0.001 0.001"/>
			<look name="black"/>
		</link>

		<link name="gripper/finger1" type="model" physics="submerged">
			<physical>
				<mesh filename="$(find stonefish_net)/data/gripper/pinza1_phy.obj" scale="1.0"/>
				<origin rpy="0.0 0.0 -0.12" xyz="-0.025 -0.23 -0.065"/>
			</physical>
			<visual>
				<mesh filename="$(find stonefish_net)/data/gripper/gripper_3.obj" scale="1.0"/>
				<origin rpy="0.0 0.0 -0.12" xyz="-0.025 -0.23 -0.065"/>
			</visual>
			<material name="Neutral"/>
			<mass value="0.1"/>
			<inertia xyz="0.001 0.001 0.001"/>
			<look name="black"/>
		</link>

		<link name="gripper/finger2" type="model" physics="submerged" buoyant="false">
			<physical>
				<mesh filename="$(find stonefish_net)/data/gripper/pinza2_phy.obj" scale="1.0"/>
				<origin rpy="0.0 0.0 -0.12" xyz="-0.24 -0.23 -0.1"/>
			</physical>
			<visual>
				<mesh filename="$(find stonefish_net)/data/gripper/gripper_2.obj" scale="1.0"/>
				<origin rpy="0.0 0.0 -0.12" xyz="-0.325 -0.215 -0.1"/>
			</visual>
			<material name="Neutral"/>
			<mass value="0.1"/>
			<inertia xyz="0.001 0.001 0.001"/>
			<look name="black"/>
		</link>

		<joint name="gripper/fixed" type="fixed">
			<parent name="Vehicle"/>
			<child name="gripper/base"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</joint>

		<joint name="gripper/joint1" type="revolute">
			<parent name="gripper/base"/>
			<child name="gripper/finger1"/>
			<origin rpy="0.0 0.0 0.12" xyz="0.0 0.33 0.065"/>
			<axis xyz="1 0 0"/>
			<limits min="-3.1" max="3.1"/>
		</joint>

		<joint name="gripper/joint2" type="revolute">
			<parent name="gripper/base"/>
			<child name="gripper/finger2"/>
			<origin rpy="0.0 0.0 0.12" xyz="0.3 0.36 0.1"/>
			<axis xyz="-1 0 0"/>
			<limits min="-3.1" max="3.1"/>
		</joint>

		<actuator name="gripper1" type="servo">
			<joint name="gripper/joint1"/>
			<controller position_gain="1.0" velocity_gain="1.0" max_torque="10.0"/>
			<initial position="-0.5"/>
		</actuator>

		<actuator name="gripper2" type="servo">
			<joint name="gripper/joint2"/>
			<controller position_gain="1.0" velocity_gain="1.0" max_torque="10.0"/>
			<initial position="-0.5"/>
		</actuator>

		
		<!--   THRUSTERS   -->
		<!-- T1 -->
		<actuator name="Thruster_R_FORWARD_FRONT" type="thruster">
			<origin rpy="0.0 0.0 0.7853981633974483" xyz="-0.10335 0.13007 0.027378"/>
			<specs max_setpoint="${3278.0/60.0*2.0*pi}" inverted_setpoint="false" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="true">
				<mesh filename="bluerov2_heavy2/Propeller.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
			<link name="Vehicle"/>
			<rotor_dynamics type="mechanical_pi">
				<rotor_inertia value="0.05"/>
				<kp value="0.8"/>
				<ki value="0.2"/>
				<ilimit value="2.0"/>
			</rotor_dynamics>
			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.52" reverse="0.48"/>
				<torque_coeff value="0.001"/>
			</thrust_model>
		</actuator>

		<!-- T2 -->
		<actuator name="Thruster_L_FORWARD_FRONT" type="thruster">
			<origin rpy="0.0 0.0 -3.9269908169872414" xyz="0.10224 0.13007 0.027084"/>
			<specs max_setpoint="${3278.0/60.0*2.0*pi}" inverted_setpoint="false" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="true">
				<mesh filename="bluerov2_heavy2/Propeller.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
			<link name="Vehicle"/>
			<rotor_dynamics type="mechanical_pi">
				<rotor_inertia value="0.05"/>
				<kp value="0.8"/>
				<ki value="0.2"/>
				<ilimit value="2.0"/>
			</rotor_dynamics>
			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.52" reverse="0.48"/>
				<torque_coeff value="0.001"/>
			</thrust_model>
		</actuator>

		<!-- T3 -->
		<actuator name="Thruster_R_FORWARD_REAR" type="thruster">
			<origin rpy="0.0 0.0 -0.7853981633974483" xyz="-0.10196 -0.15372 0.026784"/>
			<specs max_setpoint="${3278.0/60.0*2.0*pi}" inverted_setpoint="true" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="false">
				<mesh filename="bluerov2_heavy2/Propeller.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
			<link name="Vehicle"/>
			<rotor_dynamics type="mechanical_pi">
				<rotor_inertia value="0.05"/>
				<kp value="0.8"/>
				<ki value="0.2"/>
				<ilimit value="2.0"/>
			</rotor_dynamics>
			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.52" reverse="0.48"/>
				<torque_coeff value="0.001"/>
			</thrust_model>
		</actuator>

		<!-- T4 -->
		<actuator name="Thruster_L_FORWARD_REAR" type="thruster">
			<origin rpy="0.0 0.0 3.9269908169872414" xyz="0.10288 -0.15091 0.027475"/>
			<specs max_setpoint="${3278.0/60.0*2.0*pi}" inverted_setpoint="false" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="true">
				<mesh filename="bluerov2_heavy2/Propeller.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
			<link name="Vehicle"/>
			<rotor_dynamics type="mechanical_pi">
				<rotor_inertia value="0.05"/>
				<kp value="0.8"/>
				<ki value="0.2"/>
				<ilimit value="2.0"/>
			</rotor_dynamics>
			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.52" reverse="0.48"/>
				<torque_coeff value="0.001"/>
			</thrust_model>
		</actuator>

		<!-- T5 -->
		<actuator name="Thruster_R_UP_FRONT" type="thruster">
			<origin rpy="0.0 -1.5707963267948966 0.0" xyz="-0.218 0.117 -0.037726"/>
			<specs max_setpoint="${3278.0/60.0*2.0*pi}" inverted_setpoint="true" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="true">
				<mesh filename="bluerov2_heavy2/Propeller.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
			<link name="Vehicle"/>
			<rotor_dynamics type="mechanical_pi">
				<rotor_inertia value="0.05"/>
				<kp value="0.8"/>
				<ki value="0.2"/>
				<ilimit value="2.0"/>
			</rotor_dynamics>
			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.52" reverse="0.48"/>
				<torque_coeff value="0.001"/>
			</thrust_model>
		</actuator>

		<!-- T6 -->
		<actuator name="Thruster_L_UP_FRONT" type="thruster">
			<origin rpy="0.0 -1.5707963267948966 0." xyz="0.218 0.117 -0.037726"/>
			<specs max_setpoint="${3278.0/60.0*2.0*pi}" inverted_setpoint="false" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="false">
				<mesh filename="bluerov2_heavy2/Propeller.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
			<link name="Vehicle"/>
			<rotor_dynamics type="mechanical_pi">
				<rotor_inertia value="0.05"/>
				<kp value="0.8"/>
				<ki value="0.2"/>
				<ilimit value="2.0"/>
			</rotor_dynamics>
			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.52" reverse="0.48"/>
				<torque_coeff value="0.001"/>
			</thrust_model>
		</actuator>

		<!-- T7 -->
		<actuator name="Thruster_R_UP_REAR" type="thruster">
			<origin rpy="0.0 -1.5707963267948966 0.0" xyz="-0.218 -0.123 -0.037726"/>
			<specs max_setpoint="${3278.0/60.0*2.0*pi}" inverted_setpoint="false" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="false">
				<mesh filename="bluerov2_heavy2/Propeller.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
			<link name="Vehicle"/>
			<rotor_dynamics type="mechanical_pi">
				<rotor_inertia value="0.05"/>
				<kp value="0.8"/>
				<ki value="0.2"/>
				<ilimit value="2.0"/>
			</rotor_dynamics>
			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.52" reverse="0.48"/>
				<torque_coeff value="0.001"/>
			</thrust_model>
		</actuator>

		<!-- T8 -->
		<actuator name="Thruster_L_UP_REAR" type="thruster">
			<origin rpy="0.0 -1.5707963267948966 0.0" xyz="0.218 -0.123 -0.037726"/>
			<specs max_setpoint="${3278.0/60.0*2.0*pi}" inverted_setpoint="true" normalized_setpoint="true"/>
			<propeller diameter="0.07" right="true">
				<mesh filename="bluerov2_heavy2/Propeller.obj" scale="1.0"/>
				<material name="Neutral"/>
				<look name="propeller"/>
			</propeller>
			<link name="Vehicle"/>
			<rotor_dynamics type="mechanical_pi">
				<rotor_inertia value="0.05"/>
				<kp value="0.8"/>
				<ki value="0.2"/>
				<ilimit value="2.0"/>
			</rotor_dynamics>
			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.52" reverse="0.48"/>
				<torque_coeff value="0.001"/>
			</thrust_model>
		</actuator>

		<!--   SENSORS   -->
		<sensor name="dynamics" type="odometry" rate="100.0">
			<link name="Vehicle"/>
			<origin rpy="0.0 0.0 1.57" xyz="0.0 0.0 0.0"/>
			<ros_publisher topic="/bluerov/stonefish/odometry"/>
		</sensor>

		<sensor name="IMU" rate="100.0" type="imu">
		    <range angular_velocity="0.0 0.0 0.0" linear_acceleration="0.0"/>
		    <noise angle="0.0 0.0 0.0" angular_velocity="0.00" yaw_drift="0.000" linear_acceleration="0.0"/>
		    <history samples="1"/>
		    <origin xyz="0.05 0.0 -0.05" rpy="-1.57 0 1.57"/>
		    <link name="Vehicle"/>
		    <ros_publisher topic="/bluerov/stonefish/sensors/imu"/>
		</sensor>


		<sensor name="gps" type="gps" rate="1.0">
			<link name="Vehicle"/>
			<origin rpy="0.0 0.0 1.57" xyz="0.2 0 -0.1"/>
			<noise ned_position="0.0"/>
			<ros_publisher topic="/bluerov/stonefish/sensors/gps"/>
		</sensor>
		
		<sensor name="Pressure" rate="50.0" type="pressure">
		    <range pressure="10000000.0"/>
		    <noise pressure="0.0"/>
		    <history samples="1"/>
		    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		    <link name="Vehicle"/>
		    <ros_publisher topic="/bluerov/stonefish/sensors/pressure"/>
		</sensor>
		
		<sensor name="DVL" rate="20.0" type="dvl">
		    <specs beam_angle="30.0" beam_positive_z="true"/>
		    <range velocity="10.0 10.0 5.0" altitude_min="0.5" altitude_max="50.0"/>
		    <water_layer minimum_layer_size="10.0" boundary_near="10.0" boundary_far="30.0"/>
		    <noise velocity_percent= "0.0" velocity="0.0" altitude="0.0" water_velocity_percent="0.0" water_velocity="0.0"/>
		    <history samples="1"/>
		    <origin xyz="0.2 0.0 0.0" rpy="0.0 0.0 1.57"/>
		    <link name="Vehicle"/>
		    <ros_publisher topic="/bluerov/stonefish/sensors/dvl_sim" altitude_topic="/bluerov/stonefish/sensors/dvl_altitude"/>
		</sensor>

		<!--sensor name="multibeam_link" rate="2.0" type="multibeam">
			<specs fov="60.0" steps="64"/>
			<range distance_min="0.1" distance_max="50.0"/>
			<noise distance="0"/>
			<history samples="1"/>
			<origin xyz="0.0 0.0 0.15" rpy="0 0.0 1.57"/>
			<link name="Vehicle"/>
			<ros_publisher topic="/bluerov/multibeam_link/scan" pcl_topic="/bluerov/multibeam_link/pcd"/>
		</sensor> -->
		
		<!-- <sensor name="camera_gripper" rate="10.0" type="camera">
			<specs resolution_x="960" resolution_y="540" horizontal_fov="82.0"/>
			<origin xyz="0.01 0.33 0.08" rpy="1.6 0.0 3.08"/>
			<link name="Vehicle"/>
			<ros_publisher topic="/bluerov/gripper/camera"/>
		</sensor> -->

		<sensor name="front_camera" rate="10.0" type="camera">
			<specs resolution_x="1200" resolution_y="800" horizontal_fov="90.0"/>
			<origin xyz="0.0 0.18 -0.03" rpy="1.6 0.0 3.1416"/>
			<link name="Vehicle"/>
			<ros_publisher topic="/bluerov/stonefish/front_camera"/>
		</sensor>
		
		<sensor name="down_camera" rate="10.0" type="camera">
			<specs resolution_x="960" resolution_y="540" horizontal_fov="82.0"/>
			<origin xyz="0.13 0.006 0.143" rpy="0 0 3.1416"/>
			<link name="Vehicle"/>
			<ros_publisher topic="/bluerov/stonefish/down_camera"/>
		</sensor>
		
		<sensor name="right_camera" rate="10.0" type="camera">
			<specs resolution_x="960" resolution_y="540" horizontal_fov="82.0"/>
			<origin xyz="0.007 0.14 -0.1" rpy="1.57 0 3.1416"/>
			<link name="Vehicle"/>
			<ros_publisher topic="/bluerov/stonefish/right_camera"/>
		</sensor>
		
		<sensor name="left_camera" rate="10.0" type="camera">
			<specs resolution_x="960" resolution_y="540" horizontal_fov="82.0"/>
			<origin xyz="-0.06 0.14 -0.1" rpy="1.57 0 3.1416"/>
			<link name="Vehicle"/>
			<ros_publisher topic="/bluerov/stonefish/left_camera"/>
		</sensor>

		<sensor name="front_depth_camera" rate="10.0" type="depthcamera">
            <specs resolution_x="800" resolution_y="600" horizontal_fov="60.0" depth_min="0.2" depth_max="10.0"/>
            <noise depth="0.02"/>
            <origin xyz="0.0 0.18 -0.03" rpy="1.6 0.0 3.1416"/>
            <link name="Vehicle"/>
            <ros_publisher topic="/bluerov/stonefish/front_depth_camera" frame_id="bluerov/camera_front/optical_frame"/>
        </sensor>

		<world_transform rpy="0.0 0.0 0.0" xyz="0 0 0.25"/>

		<!-- <ros_control_interface namespace="/$(arg robot_name)/gripper" type="position">
			<joint name="gripper/joint1" />
			<joint name="gripper/joint2" />
		</ros_control_interface> -->

		<!--   ROS SUBSCRIBERS / PUBLISHER THRUST/FORCES   -->
		<!-- <ros_publisher servos="/joint_states"/>
        <ros_subscriber servos="/$(arg robot_name)/servo_commands"/> -->
		<ros_subscriber thrusters="/bluerov/controller/thruster_setpoints_sim" forces="/bluerov/controller/thruster_manager/input_stamped" servos="/$(arg robot_name)/servo_commands"/>
		<ros_publisher thrusters="/bluerov/controller/thruster_state" forces="/bluerov/controller/thruster_manager/output" servos="/joint_states"/>
		<ros_base_link_transforms publish="false"/>
	</robot>
</scenario>
