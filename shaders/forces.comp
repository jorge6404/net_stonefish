// a. Fuerzas sobre cada nudo con el estado del subpaso anterior: peso − empuje, Morison de sus tramos y arrastre de
// su nudo (con Cn(Re) y Cd(Re) si nu > 0, como core/hydro.hpp), limitado.
// Escribe la velocidad nueva aparte (VNEW): nadie mueve un nudo hasta predict.comp.
#version 430
#include "xpbd_common.glsl"

// core::cylinder_cn y core::sphere_cd
float cylinder_cn(float re)
{
  const float r = max(re, 1.0);
  return 1.0 + 10.0 / pow(r * r, 1.0 / 3.0);
}

float sphere_cd(float re)
{
  const float r = max(re, 0.01);
  return 24.0 / r + 6.0 / (1.0 + sqrt(r)) + 0.4;
}

vec3 morison(vec3 p0, vec3 p1, vec3 v0, vec3 v1, vec3 w, float diameter)
{
  const vec3 axis = p1 - p0;
  const float len = length(axis);
  if (len < 1e-9) {
    return vec3(0.0);
  }
  const vec3 t = axis / len;
  const vec3 u = w - 0.5 * (v0 + v1);
  const vec3 ut = dot(u, t) * t;
  const vec3 un = u - ut;
  const float cn_re = nu > 0.0 ? cylinder_cn(length(un) * diameter / nu) : cn;
  return 0.5 * rho * diameter * len * (cn_re * length(un) * un + ct * PI * length(ut) * ut);
}

vec3 knot_drag(vec3 v, vec3 w, float dk)
{
  if (dk <= 0.0) {
    return vec3(0.0);
  }
  const vec3 u = w - v;
  const float speed = length(u);
  const float cd = nu > 0.0 ? sphere_cd(speed * dk / nu) : KNOT_CD;
  return 0.5 * rho * cd * PI / 4.0 * dk * dk * speed * u;
}

void main()
{
  const uint k = gl_GlobalInvocationID.x;
  if (k >= n) {
    return;
  }
  const float w = X[k].w;
  if (w <= 0.0) {
    VNEW[k] = vec4(0.0);
    return;
  }
  const vec3 x = X[k].xyz, v = V[k].xyz;
  vec3 drag = vec3(0.0);
  for (int a = ADJ_BEGIN[k]; a < ADJ_BEGIN[k + 1]; ++a) {
    const int i = ADJ_LINKS[a];
    const int na = LINKS[i].x, nb = LINKS[i].y;
    drag += 0.5 * morison(X[na].xyz, X[nb].xyz, V[na].xyz, V[nb].xyz,
                          0.5 * (water_at(X[na].xyz) + water_at(X[nb].xyz)), LPROPS[i].y);
  }
  drag += knot_drag(v, water_at(x), NPROPS[k].w);
  // Arrastre limitado para no pasar de la velocidad del agua en un subpaso
  const float inertial = NPROPS[k].z;
  const float limit = inertial * length(water_at(x) - v) / h;
  const float norm = length(drag);
  drag = limit <= 0.0 ? vec3(0.0) : (norm > limit ? drag * (limit / norm) : drag);
  const vec3 f = drag + vec3(0.0, 0.0, (NPROPS[k].x - rho * NPROPS[k].y) * g);
  VNEW[k] = vec4(v + h * w * f, 0.0);
}
