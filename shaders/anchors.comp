// c. Anclajes: el nudo y el ojal de su boya van al mismo punto, cada uno según su masa (core::Anchor). El ojal sigue
// su camino sin la red (interpolado entre el inicio y el final del tick) más lo que la red lo ha apartado en este
// tick, con su inercia; se acumula m·Δx del nudo para la reacción sobre la boya
#version 430
#include "xpbd_common.glsl"

layout(std430, binding = B_ANCHOR_STATE) buffer AnchorState { vec4 ANCHOR_STATE[]; };  // por anclaje: apartado, velocidad

void main()
{
  const uint j = gl_GlobalInvocationID.x;
  if (j >= n) {
    return;
  }
  const int k = ANCHORS[j].node.x;
  const float w = X[k].w;
  if (w <= 0.0) {
    return;
  }
  vec3 offset0 = vec3(0.0), vel = vec3(0.0);
  if (substep > 0u) {
    offset0 = ANCHOR_STATE[2 * j].xyz;
    vel = ANCHOR_STATE[2 * j + 1].xyz;
  }
  const vec3 offset = offset0 + h * vel;
  const vec3 eye = ANCHORS[j].from.xyz + (float(substep + 1u) / float(substeps)) * (ANCHORS[j].to.xyz - ANCHORS[j].from.xyz) + offset;
  const mat3 inv_mass = mat3(ANCHORS[j].inv_mass[0].xyz, ANCHORS[j].inv_mass[1].xyz, ANCHORS[j].inv_mass[2].xyz);
  const vec3 lambda = inverse(mat3(w) + inv_mass) * (X[k].xyz - eye);
  const vec3 dx = -w * lambda;
  X[k].xyz += dx;
  DX[k].xyz += dx;
  ANCHOR_DX[j].xyz += dx / w;
  const vec3 moved = offset + inv_mass * lambda;
  ANCHOR_STATE[2 * j] = vec4(moved, 0.0);
  ANCHOR_STATE[2 * j + 1] = vec4((moved - offset0) / h, 0.0);
}
